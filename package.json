{
  "name": "github-mcp-server-js",
  "version": "0.1.6",
  "description": "A GitHub MCP server built on octokit.js and the MCP TypeScript SDK v2 — 100+ tools across 16 toolsets, packaged as npm and .mcpb Claude Desktop Extension.",
  "type": "module",
  "license": "MIT",
  "author": "Qunfei Wu",
  "homepage": "https://github.com/wuqunfei/github-mcp-server-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuqunfei/github-mcp-server-js.git"
  },
  "bugs": {
    "url": "https://github.com/wuqunfei/github-mcp-server-js/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "github",
    "octokit",
    "claude",
    "claude-desktop"
  ],
  "bin": {
    "github-mcp-server-js": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "spellcheck": "cspell \"**/*.{ts,md}\"",
    "test": "vitest run",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:integration:write": "npm run build",
    "test:integration:write": "INTEGRATION_WRITE=1 vitest run --config vitest.integration.config.ts",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "pack:npm-dry": "npm pack --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@whatwg-node/server": "^0.11.0",
    "octokit": "^5.0.5",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nock": "^14.0.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "cspell"
    ]
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
